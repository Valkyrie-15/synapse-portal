generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hospital {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  city      String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users       User[]
  insurers    Insurer[]
  portalStats PortalStats[]
}

model User {
  id         String    @id @default(cuid())
  username   String    @unique
  password   String
  role       String    @default("USER") // SUPER_ADMIN | USER
  name       String    @default("")
  hospitalId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
}

model Insurer {
  id          String       @id @default(cuid())
  name        String
  code        String       // unique per hospital
  hospitalId  String
  hospital    Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  logoUrl     String?
  portalUrl      String?
  portalUsername String?
  portalPassword String?
  driveUrl       String?
  kind        String       @default("INSURER") // INSURER | TPA
  selfChannel Boolean      @default(false)     // insurer processes claims itself (shown as "Self" TPA option)
  tpas        Insurer[]    @relation("InsurerTpas")
  insurers    Insurer[]    @relation("InsurerTpas")
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  documents   Document[]
  contacts    Contact[]
  commercials Commercial[]
  claimsStats ClaimsStats?

  @@unique([hospitalId, code])
}

model Document {
  id        String       @id @default(cuid())
  insurerId String
  type      String
  title     String
  url       String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  insurer   Insurer      @relation(fields: [insurerId], references: [id], onDelete: Cascade)
}

model Contact {
  id        String   @id @default(cuid())
  insurerId String
  name      String
  role      String
  email     String?
  phone     String?
  mobile    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  insurer   Insurer  @relation(fields: [insurerId], references: [id], onDelete: Cascade)
}

model Commercial {
  id              String   @id @default(cuid())
  insurerId       String
  category        String
  description     String
  discountPercent Float?
  packageRate     Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  insurer         Insurer  @relation(fields: [insurerId], references: [id], onDelete: Cascade)
}

model ClaimsStats {
  id                  String   @id @default(cuid())
  insurerId           String   @unique
  pending             Int      @default(0)
  approved            Int      @default(0)
  queries             Int      @default(0)
  rejected            Int      @default(0)
  todaysClaims        Int      @default(0)
  monthlyClaims       Int      @default(0)
  alReceived          Int      @default(0)
  enhancementPending  Int      @default(0)
  dischargePending    Int      @default(0)
  paymentReceived     Int      @default(0)
  totalAmountApproved Float    @default(0)
  totalAmountReceived Float    @default(0)
  totalAmountDeducted Float    @default(0)
  totalCasesProcessed Int      @default(0)
  totalApprovedCases  Int      @default(0)
  totalDeniedCases    Int      @default(0)
  updatedAt           DateTime @updatedAt
  insurer             Insurer  @relation(fields: [insurerId], references: [id], onDelete: Cascade)
}

// Live numbers scraped from a provider portal (one row per hospital + portal, e.g. IHX).
// A portal login usually covers several insurers/TPAs, so these are portal-wide totals.
// Null means the portal does not show that figure.
model PortalStats {
  id                 String    @id @default(cuid())
  hospitalId         String
  portal             String    // key from src/lib/portals.ts, e.g. "IHX"
  pending            Int?
  approved           Int?
  queries            Int?
  rejected           Int?
  dischargePending   Int?
  enhancementPending Int?
  status             String    @default("OK") // OK | ERROR | BLOCKED (OTP/captcha) | NO_PARSER
  message            String?
  scrapedAt          DateTime? // last successful scrape
  checkedAt          DateTime  @default(now()) // last attempt
  hospital           Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, portal])
}
